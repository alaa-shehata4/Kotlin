<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 31 — cold-start splash: calm mint background with the CareBrief mark
     centered. Shown via Theme.CareBrief.Splash as windowBackground, then
     replaced by the Compose UI once MainActivity resumes the app theme. -->
